@startuml interactions-contenu-service
!include style.iuml
left to right direction
skinparam rectangle {
  BorderColor #B00020
  BackgroundColor #FFFFFF
  FontStyle bold
}
skinparam queue {
  BorderColor #C2410C
  BackgroundColor #FFF4EC
  FontColor #9A3412
}
title MS2 contenu-service : interactions
rectangle "MS2\ncontenu-service" as S #FBE9EB
rectangle "MS3 seance-service" as N0 #FFFFFF
N0 --> S : GET /api/sujets/{id}
rectangle "MS4 examen-service" as N1 #FFFFFF
N1 --> S : GET /api/sujets/tirage
rectangle "MS-IA analyse-service" as N2 #FFFFFF
N2 --> S : GET /api/sujets/{id}
note bottom of S
  Aucun événement Kafka :
  MS2 ne publie ni ne consomme.
end note
legend right
  flèche pleine : appel synchrone (REST, OpenFeign via Eureka)
  flèche pointillée : événement Kafka (asynchrone)
endlegend
@enduml
