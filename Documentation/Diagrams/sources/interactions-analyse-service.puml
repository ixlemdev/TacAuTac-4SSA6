@startuml interactions-analyse-service
!include style.iuml
left to right direction
skinparam rectangle {
  BorderColor #B00020
  BackgroundColor #FFFFFF
  FontStyle bold
}
skinparam queue {
  BorderColor #C2410C
  BackgroundColor #FFF4EC
  FontColor #9A3412
}
title MS-IA analyse-service (Python) : interactions
rectangle "MS-IA\nanalyse-service\nPython · FastAPI" as S #FBE9EB
rectangle "Frontend, via la Gateway" as N0 #F4F6F8
N0 --> S : tous les endpoints
rectangle "MS3 seance-service" as N1 #FFFFFF
S --> N1 : GET /api/enregistrements/{id}/audio
rectangle "MS2 contenu-service" as N2 #FFFFFF
S --> N2 : GET /api/sujets/{id}
database "MongoDB\ntacautac_analyse" as DB #F4F6F8
S --> DB : lit / écrit
queue "audio.recu" as T0
T0 ..> S #C2410C : consomme
queue "enregistrement.supprime" as T1
T1 ..> S #C2410C : consomme
queue "analyse.terminee" as T2
S ..> T2 #C2410C : publie
queue "analyse.echouee" as T3
S ..> T3 #C2410C : publie
queue "analyse.validee" as T4
S ..> T4 #C2410C : publie
note bottom of S
  Pipeline IA intégré au service :
  Whisper, wav2vec 2.0, Parselmouth,
  LanguageTool, petit LLM
end note
legend right
  flèche pleine : appel synchrone (REST via Eureka : httpx et py-eureka-client)
  flèche pointillée : événement Kafka (asynchrone, aiokafka)
endlegend
@enduml
