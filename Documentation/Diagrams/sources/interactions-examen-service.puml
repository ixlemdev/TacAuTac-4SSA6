@startuml interactions-examen-service
!include style.iuml
left to right direction
skinparam rectangle {
  BorderColor #B00020
  BackgroundColor #FFFFFF
  FontStyle bold
}
skinparam queue {
  BorderColor #C2410C
  BackgroundColor #FFF4EC
  FontColor #9A3412
}
title MS4 examen-service : interactions
rectangle "MS4\nexamen-service" as S #FBE9EB
rectangle "Frontend, via la Gateway" as N0 #F4F6F8
N0 --> S : tous les endpoints
rectangle "Public" as N1 #F4F6F8
N1 --> S : GET /api/attestations/verifications/{code}
rectangle "MS2 contenu-service" as N2 #FFFFFF
S --> N2 : GET /api/sujets/tirage?langue=&niveau=&certification=
rectangle "MS1 profil-service" as N3 #FFFFFF
S --> N3 : GET /api/profils/{apprenantId}
queue "analyse.terminee" as T0
T0 ..> S #C2410C : consomme
queue "analyse.echouee" as T1
T1 ..> S #C2410C : consomme
queue "analyse.validee" as T2
T2 ..> S #C2410C : consomme
queue "examen.termine" as T3
S ..> T3 #C2410C : publie
legend right
  flèche pleine : appel synchrone (REST, OpenFeign via Eureka)
  flèche pointillée : événement Kafka (asynchrone)
endlegend
@enduml
