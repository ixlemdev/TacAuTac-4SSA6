skinparam defaultFontName Inter
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam dpi 150
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #555555
skinparam ArrowFontColor #444444
skinparam ArrowFontSize 11
skinparam TitleFontSize 18
skinparam TitleFontStyle bold
skinparam TitleFontColor #222222
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #C9A227
skinparam NoteFontSize 11

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #B00020
  BorderThickness 1.2
  HeaderBackgroundColor #FBE9EB
  AttributeFontSize 12
  StereotypeFontColor #8A1C2B
  StereotypeFontSize 10
}
skinparam enum {
  BackgroundColor #F4F6F8
  BorderColor #7A8794
  HeaderBackgroundColor #E8ECF0
}
skinparam package {
  BorderColor #B00020
  FontColor #B00020
  FontStyle bold
  BackgroundColor #FFFFFF
}
skinparam stereotypeCBackgroundColor #F2C2C8
skinparam stereotypeEBackgroundColor #D9DEE3
hide empty methods
skinparam class {
  BackgroundColor<<Enum>> #F4F6F8
  BorderColor<<Enum>> #7A8794
  HeaderBackgroundColor<<Enum>> #E8ECF0
}
