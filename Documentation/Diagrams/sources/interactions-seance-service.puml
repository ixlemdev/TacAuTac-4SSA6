@startuml interactions-seance-service
!include style.iuml
left to right direction
skinparam rectangle {
  BorderColor #B00020
  BackgroundColor #FFFFFF
  FontStyle bold
}
skinparam queue {
  BorderColor #C2410C
  BackgroundColor #FFF4EC
  FontColor #9A3412
}
title MS3 seance-service : interactions
rectangle "MS3\nseance-service" as S #FBE9EB
rectangle "MS-IA analyse-service" as N0 #FFFFFF
N0 --> S : GET /api/enregistrements/{id}/audio
rectangle "Frontend, via la Gateway" as N1 #F4F6F8
N1 --> S : tous les endpoints
rectangle "MS1 profil-service" as N2 #FFFFFF
S --> N2 : GET /api/profils/{apprenantId}
S --> N2 : GET /api/groupes?formateurId=&membreId=
rectangle "MS2 contenu-service" as N3 #FFFFFF
S --> N3 : GET /api/sujets/{sujetId}
queue "audio.recu" as T0
S ..> T0 #C2410C : publie
queue "enregistrement.supprime" as T1
S ..> T1 #C2410C : publie
queue "analyse.terminee" as T2
T2 ..> S #C2410C : consomme
queue "analyse.echouee" as T3
T3 ..> S #C2410C : consomme
legend right
  flèche pleine : appel synchrone (REST, OpenFeign via Eureka)
  flèche pointillée : événement Kafka (asynchrone)
endlegend
@enduml
